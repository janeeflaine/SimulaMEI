{
    "version": 2,
    "installCommand": "npm install && cd client && npm install --include=dev && cd ../server && npm install",
    "buildCommand": "cd client && npm run build",
    "outputDirectory": "client/dist",
    "functions": {
        "api/[...path].js": {
            "includeFiles": "server/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}