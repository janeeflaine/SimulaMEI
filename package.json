{
    "name": "simulamei-monorepo",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": "20.x"
    },
    "scripts": {
        "install-all": "npm install && cd client && npm install --include=dev && cd ../server && npm install",
        "build": "cd client && npm run build",
        "start": "cd server && npm start",
        "dev": "concurrently \"cd server && npm run dev\" \"cd client && npm run dev\""
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "bcryptjs": "^3.0.3",
        "concurrently": "^8.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mercadopago": "^2.11.0",
        "multer": "^2.1.1",
        "nodemailer": "^8.0.4",
        "pg": "^8.17.1",
        "stripe": "^21.0.1"
    }
}
